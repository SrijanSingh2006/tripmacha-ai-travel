# ==========================================================
# TripMacha Environment Variables Template
# Copy this file to .env in your backend directory or root
# ==========================================================

# 1. Google Gemini AI API Key (Required for chat agent & LLM scrapers)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Redis Message Broker & Result Store (For Celery tasks)
# Local non-docker default: redis://localhost:6379/0
# Docker compose default: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 3. PostgreSQL Database Connection (Optional / for user profile, history, wallet)
DATABASE_URL=postgresql://tripmacha_admin:local_password_123@localhost:5432/tripmacha_dev_db

# 4. Frontend CORS Configuration
FRONTEND_URL=http://localhost:5173

# 5. Frontend Google OAuth (Frontend .env)
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
